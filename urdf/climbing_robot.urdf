<?xml version="1.0"?>
<!--
  Simplified differential-drive stand-in for ClimbingRobot_v1.
  Proportions carried over from the Fusion reference (mm -> m):
    chassis   360 x 260 x 12 mm  -> 0.36 x 0.26 x 0.012 m
    track gauge (centerline)     -> +/-0.13 m
    sprocket / wheel radius 35mm -> 0.035 m
  Standard ROS/URDF convention used here: X forward, Y left, Z up
  (deliberately NOT the Fusion document's Y-up convention -- this is
  a fresh robotics-standard description, not a CAD export).
-->
<robot name="climbing_robot">

  <material name="chassis_grey"><color rgba="0.55 0.53 0.5 1"/></material>
  <material name="wheel_dark"><color rgba="0.15 0.15 0.15 1"/></material>
  <material name="caster_light"><color rgba="0.7 0.7 0.7 1"/></material>

  <link name="base_link">
    <visual>
      <geometry><box size="0.36 0.26 0.012"/></geometry>
      <material name="chassis_grey"/>
    </visual>
    <collision>
      <geometry><box size="0.36 0.26 0.012"/></geometry>
    </collision>
    <inertial>
      <mass value="2.5"/>
      <inertia ixx="0.015" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.04"/>
    </inertial>
  </link>

  <!-- LEFT track drive wheel -->
  <link name="left_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="0 0.13 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- RIGHT track drive wheel -->
  <link name="right_wheel">
    <visual>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
      <material name="wheel_dark"/>
    </visual>
    <collision>
      <origin rpy="1.5708 0 0"/>
      <geometry><cylinder radius="0.035" length="0.02"/></geometry>
    </collision>
    <inertial>
      <mass value="0.15"/>
      <inertia ixx="0.00006" ixy="0" ixz="0" iyy="0.00006" iyz="0" izz="0.0001"/>
    </inertial>
  </link>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="0 -0.13 0"/>
    <axis xyz="0 1 0"/>
  </joint>

  <!-- front / rear low-friction caster balls, purely for stability -->
  <link name="caster_front">
    <visual><geometry><sphere radius="0.015"/></geometry><material name="caster_light"/></visual>
    <collision><geometry><sphere radius="0.015"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="caster_front_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_front"/>
    <origin xyz="0.15 0 -0.021"/>
  </joint>

  <link name="caster_rear">
    <visual><geometry><sphere radius="0.015"/></geometry><material name="caster_light"/></visual>
    <collision><geometry><sphere radius="0.015"/></geometry></collision>
    <inertial><mass value="0.02"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>
  <joint name="caster_rear_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_rear"/>
    <origin xyz="-0.15 0 -0.021"/>
  </joint>

  <!-- control-unit stand-in mass, for a representative payload/CoG -->
  <link name="control_unit">
    <visual><geometry><box size="0.14 0.10 0.045"/></geometry><material name="wheel_dark"/></visual>
    <collision><geometry><box size="0.14 0.10 0.045"/></geometry></collision>
    <inertial><mass value="0.4"/><inertia ixx="0.0004" ixy="0" ixz="0" iyy="0.0006" iyz="0" izz="0.0008"/></inertial>
  </link>
  <joint name="control_unit_joint" type="fixed">
    <parent link="base_link"/>
    <child link="control_unit"/>
    <origin xyz="0 0 0.0285"/>
  </joint>

</robot>
